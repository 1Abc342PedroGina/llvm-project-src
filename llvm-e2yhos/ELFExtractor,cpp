bool RobustELFExtractor::recoverCorruptedELFHeader(const uint8_t *Buffer, size_t Size,
                                                    RobustELFExtractedData &Output) {
  auto SignaturePos = findELFSignature(Buffer, Size);
  if (!SignaturePos.hasValue()) {
    return false;
  }
  
  ELFHeaderOffset = *SignaturePos;
  Diagnostics.add(Severity::Info,
                  "Assinatura ELF encontrada em offset alternativo: 0x" +
                  Twine::utohexstr(ELFHeaderOffset).str());
  
  // Tentar validar com o novo offset
  auto Err = validateELFHeader(Buffer + ELFHeaderOffset, Size - ELFHeaderOffset, Output);
  if (Err) {
    Diagnostics.add(Severity::Error, toString(std::move(Err)));
    return false;
  }
  
  return true;
}

Optional<size_t> RobustELFExtractor::findELFSignature(const uint8_t *Buffer, size_t Size) {
  const uint32_t Target = ELF_MAGIC;
  
  for (size_t i = 0; i < Size - 4; i++) {
    if (memcmp(Buffer + i, &Target, 4) == 0) {
      return i;
    }
  }
  
  return None;
}

bool RobustELFExtractor::detectEndianness(const uint8_t *Buffer, size_t Size) {
  // Tenta detectar endianness olhando para valores que fazem sentido
  if (Size < 8) return true; // Default little-endian
  
  // Verificar se os valores parecem little-endian
  uint16_t TypeLE = *reinterpret_cast<const uint16_t*>(Buffer + 16);
  uint16_t TypeBE = support::endian::byte_swap<uint16_t>(TypeLE);
  
  if (TypeLE == ET_EXEC || TypeLE == ET_DYN || TypeLE == ET_REL) {
    return true; // Little-endian
  }
  if (TypeBE == ET_EXEC || TypeBE == ET_DYN || TypeBE == ET_REL) {
    return false; // Big-endian
  }
  
  return true; // Default
}

bool RobustELFExtractor::detectClass(const uint8_t *Buffer, size_t Size) {
  if (Size < 5) return true; // Default 64-bit
  
  return (Buffer[4] == ELFCLASS64);
}

//==============================================================================
// UTILITÁRIOS DE SEGURANÇA
//==============================================================================

bool RobustELFExtractor::isSafeOffset(uint64_t Offset, uint64_t Size,
                                       uint64_t BufferSize) const {
  if (Offset > BufferSize) return false;
  if (Size > BufferSize) return false;
  if (Offset + Size > BufferSize) return false;
  if (Offset + Size < Offset) return false; // Overflow
  return true;
}

bool RobustELFExtractor::isSafeSize(uint64_t Size, uint64_t MaxSize) const {
  if (Size > MaxSize) return false;
  return true;
}

std::string RobustELFExtractor::getSectionNameSafe(const uint8_t *Buffer, size_t Size,
                                                    uint32_t Index,
                                                    const RobustELFExtractedData &Output) {
  if (SectionStringTableOffset == 0 || Index == 0) {
    return "";
  }
  
  if (!isSafeOffset(SectionStringTableOffset + Index, 1, Size)) {
    return "";
  }
  
  const char *NamePtr = reinterpret_cast<const char*>(Buffer + 
      SectionStringTableOffset + Index);
  size_t MaxLen = std::min<size_t>(256, Size - (SectionStringTableOffset + Index));
  
  return std::string(NamePtr, strnlen(NamePtr, MaxLen));
}

//==============================================================================
// FUNÇÕES DE MAPEAMENTO ESTÁTICAS
//==============================================================================

uint32_t RobustELFExtractor::mapELFArchToYHOS(uint16_t ELFMachine, bool Is64Bit) {
  switch (ELFMachine) {
    case EM_386:
      return ARCH_X86_32;
    case EM_X86_64:
      return ARCH_X86_64;
    case EM_ARM:
      return ARCH_ARM_32;
    case EM_AARCH64:
      return ARCH_ARM_64;
    case EM_RISCV:
      return Is64Bit ? ARCH_RISCV_64 : ARCH_RISCV_32;
    default:
      // Fallback baseado no tamanho
      return Is64Bit ? ARCH_X86_64 : ARCH_X86_32;
  }
}

uint32_t RobustELFExtractor::convertSectionFlagsToPermissions(uint64_t ELFFlags) {
  uint32_t Permissions = 0;
  
  if (ELFFlags & SHF_ALLOC) {
    Permissions |= SEG_READ; // Alocado é legível
  }
  if (ELFFlags & SHF_WRITE) {
    Permissions |= SEG_WRITE;
  }
  if (ELFFlags & SHF_EXECINSTR) {
    Permissions |= SEG_EXEC;
  }
  
  return Permissions;
}

uint32_t RobustELFExtractor::convertSegmentFlagsToPermissions(uint32_t ELFFlags) {
  uint32_t Permissions = 0;
  
  if (ELFFlags & PF_R) {
    Permissions |= SEG_READ;
  }
  if (ELFFlags & PF_W) {
    Permissions |= SEG_WRITE;
  }
  if (ELFFlags & PF_X) {
    Permissions |= SEG_EXEC;
  }
  
  return Permissions;
}

