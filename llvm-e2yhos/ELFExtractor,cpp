bool RobustELFExtractor::extractRobust(const uint8_t *Buffer, size_t Size,
                                        RobustELFExtractedData &Output,
                                        bool EnableHeuristics) {
  Diagnostics.clear();
  Output.Diagnostics.clear();
  Output.IsValid = false;
  Output.IsCorrupted = false;
  
  // Validação inicial
  if (!Buffer || Size == 0) {
    Diagnostics.add(Severity::Fatal, "Buffer nulo ou tamanho zero");
    return false;
  }
  
  if (Size < ELFSecurityLimits::MIN_FILE_SIZE) {
    Diagnostics.add(Severity::Fatal, 
                    "Arquivo muito pequeno: " + Twine(Size).str() + " bytes");
    return false;
  }
  
  if (Size > ELFSecurityLimits::MAX_FILE_SIZE) {
    Diagnostics.add(Severity::Fatal, 
                    "Arquivo excede limite máximo: " + Twine(Size).str() + " bytes");
    return false;
  }
  
  if (VerboseMode) {
    Diagnostics.add(Severity::Info, 
                    "Iniciando extração robusta ELF, tamanho: " + Twine(Size).str() + " bytes");
  }
  
  // Fase 1: Validação do cabeçalho ELF
  if (auto Err = validateELFHeader(Buffer, Size, Output)) {
    if (EnableHeuristics) {
      Diagnostics.add(Severity::Warning, "Cabeçalho ELF inválido, tentando recuperação");
      if (!recoverCorruptedELFHeader(Buffer, Size, Output)) {
        Diagnostics.add(Severity::Error, "Falha na recuperação do cabeçalho ELF");
        return false;
      }
    } else {
      Diagnostics.add(Severity::Fatal, toString(std::move(Err)));
      return false;
    }
  }
  
  // Fase 2: Validação e extração dos program headers
  if (auto Err = validateProgramHeaders(Buffer, Size, Output)) {
    if (VerboseMode) {
      Diagnostics.add(Severity::Warning, "Falha nos program headers: " + toString(std::move(Err)));
    }
    // Continua mesmo sem program headers (pode ser ET_REL)
  }
  
  // Fase 3: Validação e extração dos section headers
  if (auto Err = validateSectionHeaders(Buffer, Size, Output)) {
    if (VerboseMode) {
      Diagnostics.add(Severity::Warning, "Falha nos section headers: " + toString(std::move(Err)));
    }
    // Continua mesmo sem section headers (pode ser stripped)
  }
  
  // Fase 4: Extração de dados
  if (Output.HasProgramHeaders && Output.ProgramHeaders.size() > 0) {
    if (auto Err = extractFromProgramHeaders(Buffer, Size, Output)) {
      Diagnostics.add(Severity::Error, toString(std::move(Err)));
    }
  } else if (Output.HasSectionHeaders && Output.Sections.size() > 0) {
    if (auto Err = extractFromSectionsWithHeuristics(Buffer, Size, Output)) {
      Diagnostics.add(Severity::Error, toString(std::move(Err)));
    }
  } else {
    // Heurística: tentar extrair como binário puro
    Diagnostics.add(Severity::Warning, "Nenhum segmento/seção encontrada, tratando como binário puro");
    Output.CodeBuffer.assign(Buffer, Buffer + Size);
  }
  
  // Fase 5: Extração de símbolos
  if (auto Err = extractSymbolsRobust(Buffer, Size, Output)) {
    if (VerboseMode) {
      Diagnostics.add(Severity::Debug, "Símbolos: " + toString(std::move(Err)));
    }
  }
  
  // Fase 6: Extração de relocações
  if (auto Err = extractRelocationsRobust(Buffer, Size, Output)) {
    if (VerboseMode) {
      Diagnostics.add(Severity::Debug, "Relocações: " + toString(std::move(Err)));
    }
  }
  
  // Fase 7: Extração de notas
  if (auto Err = extractNotesRobust(Buffer, Size, Output)) {
    if (VerboseMode) {
      Diagnostics.add(Severity::Debug, "Notas: " + toString(std::move(Err)));
    }
  }
  
  // Fase 8: Extração de debug info
  if (auto Err = extractDebugInfoRobust(Buffer, Size, Output)) {
    if (VerboseMode) {
      Diagnostics.add(Severity::Debug, "Debug info: " + toString(std::move(Err)));
    }
  }
  
  // Fase 9: Configurar arquitetura
  Output.TargetArch = mapELFArchToYHOS(Output.Machine, Output.Is64Bit);
  
  // Fase 10: Validação final
  Output.IsValid = (Output.CodeBuffer.size() > 0 || 
                    Output.DataBuffer.size() > 0 ||
                    Output.RodataBuffer.size() > 0);
  
  Output.Diagnostics = Diagnostics;
  
  if (VerboseMode) {
    Diagnostics.add(Severity::Info, 
                    "Extração ELF concluída. Válido: " + Twine(Output.IsValid).str() +
                    ", Código: " + Twine(Output.CodeBuffer.size()).str() + " bytes" +
                    ", Dados: " + Twine(Output.DataBuffer.size()).str() + " bytes" +
                    ", Símbolos: " + Twine(Output.Stats.ValidSymbols).str());
  }
  
  return Output.IsValid;
}

bool RobustELFExtractor::extractFromFileRobust(StringRef Path,
                                                RobustELFExtractedData &Output,
                                                bool EnableHeuristics) {
  ErrorOr<std::unique_ptr<MemoryBuffer>> MemBufOrErr = 
      MemoryBuffer::getFile(Path);
  
  if (!MemBufOrErr) {
    Diagnostics.add(Severity::Fatal, 
                    "Erro ao ler arquivo: " + Path.str() + " - " +
                    MemBufOrErr.getError().message());
    return false;
  }
  
  const uint8_t *Buffer = reinterpret_cast<const uint8_t*>(
      (*MemBufOrErr)->getBufferStart());
  size_t Size = (*MemBufOrErr)->getBufferSize();
  
  return extractRobust(Buffer, Size, Output, EnableHeuristics);
}

Error RobustELFExtractor::verifyIntegrity(const uint8_t *Buffer, size_t Size) {
  RobustELFExtractedData Temp;
  return validateELFHeader(Buffer, Size, Temp);
}

//==============================================================================
// VALIDAÇÃO DO CABEÇALHO ELF
//==============================================================================

Error RobustELFExtractor::validateELFHeader(const uint8_t *Buffer, size_t Size,
                                             RobustELFExtractedData &Output) {
  // Verificar magic number
  if (Size < 4) {
    return make_error<StringError>("Buffer muito pequeno para magic ELF",
                                   inconvertibleErrorCode());
  }
  
  uint32_t Magic = *reinterpret_cast<const uint32_t*>(Buffer);
  if (Magic != ELF_MAGIC) {
    return make_error<StringError>("Magic ELF inválido: 0x" +
                                   Twine::utohexstr(Magic).str() +
                                   " (esperado 0x7F454C46)",
                                   inconvertibleErrorCode());
  }
  
  // Extrair EI_CLASS
  if (Size < 5) {
    return make_error<StringError>("Buffer muito pequeno para EI_CLASS",
                                   inconvertibleErrorCode());
  }
  
  Output.EI_CLASS = Buffer[4];
  if (Output.EI_CLASS == ELFCLASS32) {
    Output.Is64Bit = false;
    if (VerboseMode) {
      Diagnostics.add(Severity::Debug, "ELF32 detectado");
    }
  } else if (Output.EI_CLASS == ELFCLASS64) {
    Output.Is64Bit = true;
    if (VerboseMode) {
      Diagnostics.add(Severity::Debug, "ELF64 detectado");
    }
  } else {
    return make_error<StringError>("Classe ELF desconhecida: " +
                                   Twine(Output.EI_CLASS).str(),
                                   inconvertibleErrorCode());
  }
  
  // Extrair EI_DATA (endianness)
  if (Size < 6) {
    return make_error<StringError>("Buffer muito pequeno para EI_DATA",
                                   inconvertibleErrorCode());
  }
  
  Output.EI_DATA = Buffer[5];
  if (Output.EI_DATA == ELFDATA2LSB) {
    Output.IsLittleEndian = true;
    DetectedLittleEndian = true;
    if (VerboseMode) {
      Diagnostics.add(Severity::Debug, "Little-endian detectado");
    }
  } else if (Output.EI_DATA == ELFDATA2MSB) {
    Output.IsLittleEndian = false;
    DetectedLittleEndian = false;
    if (VerboseMode) {
      Diagnostics.add(Severity::Debug, "Big-endian detectado");
    }
  } else {
    return make_error<StringError>("Endianness desconhecido: " +
                                   Twine(Output.EI_DATA).str(),
                                   inconvertibleErrorCode());
  }
  
  // Extrair EI_VERSION
  if (Size < 7) {
    return make_error<StringError>("Buffer muito pequeno para EI_VERSION",
                                   inconvertibleErrorCode());
  }
  
  Output.EI_VERSION = Buffer[6];
  if (Output.EI_VERSION != EV_CURRENT && Output.EI_VERSION != EV_NONE) {
    Diagnostics.add(Severity::Warning, 
                    "Versão ELF não padrão: " + Twine(Output.EI_VERSION).str());
  }
  
  // Extrair EI_OSABI
  if (Size < 8) {
    return make_error<StringError>("Buffer muito pequeno para EI_OSABI",
                                   inconvertibleErrorCode());
  }
  
  Output.EI_OSABI = Buffer[7];
  if (Output.EI_OSABI != ELFOSABI_SYSV && Output.EI_OSABI != ELFOSABI_LINUX) {
    Diagnostics.add(Severity::Debug, 
                    "OSABI não padrão: " + Twine(Output.EI_OSABI).str());
  }
  
  // Extrair EI_ABIVERSION
  if (Size < 9) {
    return make_error<StringError>("Buffer muito pequeno para EI_ABIVERSION",
                                   inconvertibleErrorCode());
  }
  
  Output.EI_ABIVERSION = Buffer[8];
  
  // Agora processar o cabeçalho ELF baseado na classe
  if (Output.Is64Bit) {
    if (!isSafeOffset(0, sizeof(Elf64_Ehdr_Safe), Size)) {
      return make_error<StringError>("Cabeçalho ELF64 truncado",
                                     inconvertibleErrorCode());
    }
    
    const Elf64_Ehdr_Safe *Ehdr = 
        reinterpret_cast<const Elf64_Ehdr_Safe*>(Buffer);
    
    Output.Type = readSafe<uint16_t>(Buffer, offsetof(Elf64_Ehdr_Safe, e_type),
                                      Size, Output.IsLittleEndian).getValueOr(0);
    Output.Machine = readSafe<uint16_t>(Buffer, offsetof(Elf64_Ehdr_Safe, e_machine),
                                         Size, Output.IsLittleEndian).getValueOr(0);
    Output.Version = readSafe<uint32_t>(Buffer, offsetof(Elf64_Ehdr_Safe, e_version),
                                         Size, Output.IsLittleEndian).getValueOr(0);
    Output.EntryPoint = readSafe<uint64_t>(Buffer, offsetof(Elf64_Ehdr_Safe, e_entry),
                                            Size, Output.IsLittleEndian).getValueOr(0);
    
    ProgramHeaderOffset = readSafe<uint64_t>(Buffer, offsetof(Elf64_Ehdr_Safe, e_phoff),
                                              Size, Output.IsLittleEndian).getValueOr(0);
    SectionHeaderOffset = readSafe<uint64_t>(Buffer, offsetof(Elf64_Ehdr_Safe, e_shoff),
                                              Size, Output.IsLittleEndian).getValueOr(0);
    
    Output.ProgramHeaderCount = readSafe<uint16_t>(Buffer, offsetof(Elf64_Ehdr_Safe, e_phnum),
                                                    Size, Output.IsLittleEndian).getValueOr(0);
    Output.SectionHeaderCount = readSafe<uint16_t>(Buffer, offsetof(Elf64_Ehdr_Safe, e_shnum),
                                                    Size, Output.IsLittleEndian).getValueOr(0);
    Output.SectionHeaderStringIndex = readSafe<uint16_t>(Buffer, offsetof(Elf64_Ehdr_Safe, e_shstrndx),
                                                          Size, Output.IsLittleEndian).getValueOr(0);
    
  } else {
    // ELF32
    if (!isSafeOffset(0, sizeof(Elf32_Ehdr_Safe), Size)) {
      return make_error<StringError>("Cabeçalho ELF32 truncado",
                                     inconvertibleErrorCode());
    }
    
    const Elf32_Ehdr_Safe *Ehdr = 
        reinterpret_cast<const Elf32_Ehdr_Safe*>(Buffer);
    
    Output.Type = readSafe<uint16_t>(Buffer, offsetof(Elf32_Ehdr_Safe, e_type),
                                      Size, Output.IsLittleEndian).getValueOr(0);
    Output.Machine = readSafe<uint16_t>(Buffer, offsetof(Elf32_Ehdr_Safe, e_machine),
                                         Size, Output.IsLittleEndian).getValueOr(0);
    Output.Version = readSafe<uint32_t>(Buffer, offsetof(Elf32_Ehdr_Safe, e_version),
                                         Size, Output.IsLittleEndian).getValueOr(0);
    Output.EntryPoint = readSafe<uint32_t>(Buffer, offsetof(Elf32_Ehdr_Safe, e_entry),
                                            Size, Output.IsLittleEndian).getValueOr(0);
    
    ProgramHeaderOffset = readSafe<uint32_t>(Buffer, offsetof(Elf32_Ehdr_Safe, e_phoff),
                                              Size, Output.IsLittleEndian).getValueOr(0);
    SectionHeaderOffset = readSafe<uint32_t>(Buffer, offsetof(Elf32_Ehdr_Safe, e_shoff),
                                              Size, Output.IsLittleEndian).getValueOr(0);
    
    Output.ProgramHeaderCount = readSafe<uint16_t>(Buffer, offsetof(Elf32_Ehdr_Safe, e_phnum),
                                                    Size, Output.IsLittleEndian).getValueOr(0);
    Output.SectionHeaderCount = readSafe<uint16_t>(Buffer, offsetof(Elf32_Ehdr_Safe, e_shnum),
                                                    Size, Output.IsLittleEndian).getValueOr(0);
    Output.SectionHeaderStringIndex = readSafe<uint16_t>(Buffer, offsetof(Elf32_Ehdr_Safe, e_shstrndx),
                                                          Size, Output.IsLittleEndian).getValueOr(0);
  }
  
  // Validar tipo do arquivo
  switch (Output.Type) {
    case ET_REL:
      Output.IsRelocatable = true;
      Output.IsExecutable = false;
      Output.IsSharedLib = false;
      if (VerboseMode) Diagnostics.add(Severity::Debug, "Tipo: ET_REL (relocável)");
      break;
    case ET_EXEC:
      Output.IsRelocatable = false;
      Output.IsExecutable = true;
      Output.IsSharedLib = false;
      if (VerboseMode) Diagnostics.add(Severity::Debug, "Tipo: ET_EXEC (executável)");
      break;
    case ET_DYN:
      Output.IsRelocatable = false;
      Output.IsExecutable = false;
      Output.IsSharedLib = true;
      if (VerboseMode) Diagnostics.add(Severity::Debug, "Tipo: ET_DYN (biblioteca compartilhada)");
      break;
    case ET_CORE:
      Output.IsRelocatable = false;
      Output.IsExecutable = false;
      Output.IsSharedLib = false;
      Output.IsCoreDump = true;
      if (VerboseMode) Diagnostics.add(Severity::Debug, "Tipo: ET_CORE (core dump)");
      break;
    default:
      Diagnostics.add(Severity::Warning, "Tipo ELF desconhecido: " + Twine(Output.Type).str());
  }
  
  Output.HasProgramHeaders = (Output.ProgramHeaderCount > 0 && ProgramHeaderOffset > 0);
  Output.HasSectionHeaders = (Output.SectionHeaderCount > 0 && SectionHeaderOffset > 0);
  
  return Error::success();
}

//==============================================================================
// VALIDAÇÃO DE PROGRAM HEADERS
//==============================================================================

Error RobustELFExtractor::validateProgramHeaders(const uint8_t *Buffer, size_t Size,
                                                  RobustELFExtractedData &Output) {
  if (!Output.HasProgramHeaders) {
    return Error::success(); // Não há program headers
  }
  
  if (Output.ProgramHeaderCount > SecLimits.MAX_SEGMENTS) {
    return make_error<StringError>("Número excessivo de program headers: " +
                                   Twine(Output.ProgramHeaderCount).str(),
                                   inconvertibleErrorCode());
  }
  
  size_t PhdrSize = Output.Is64Bit ? sizeof(Elf64_Phdr_Safe) : sizeof(Elf32_Phdr_Safe);
  size_t PhdrTableSize = Output.ProgramHeaderCount * PhdrSize;
  
  if (!isSafeOffset(ProgramHeaderOffset, PhdrTableSize, Size)) {
    return make_error<StringError>("Tabela de program headers além do buffer",
                                   inconvertibleErrorCode());
  }
  
  Output.ProgramHeaders.clear();
  
  for (uint16_t i = 0; i < Output.ProgramHeaderCount; i++) {
    RobustELFProgramHeaderInfo Info;
    uint64_t PhdrOffset = ProgramHeaderOffset + (i * PhdrSize);
    
    if (Output.Is64Bit) {
      const Elf64_Phdr_Safe *Phdr = 
          reinterpret_cast<const Elf64_Phdr_Safe*>(Buffer + PhdrOffset);
      
      Info.Type = readSafe<uint32_t>(Buffer, PhdrOffset + offsetof(Elf64_Phdr_Safe, p_type),
                                      Size, Output.IsLittleEndian).getValueOr(0);
      Info.Flags = readSafe<uint32_t>(Buffer, PhdrOffset + offsetof(Elf64_Phdr_Safe, p_flags),
                                       Size, Output.IsLittleEndian).getValueOr(0);
      Info.Offset = readSafe<uint64_t>(Buffer, PhdrOffset + offsetof(Elf64_Phdr_Safe, p_offset),
                                        Size, Output.IsLittleEndian).getValueOr(0);
      Info.VAddr = readSafe<uint64_t>(Buffer, PhdrOffset + offsetof(Elf64_Phdr_Safe, p_vaddr),
                                       Size, Output.IsLittleEndian).getValueOr(0);
      Info.PAddr = readSafe<uint64_t>(Buffer, PhdrOffset + offsetof(Elf64_Phdr_Safe, p_paddr),
                                       Size, Output.IsLittleEndian).getValueOr(0);
      Info.FileSize = readSafe<uint64_t>(Buffer, PhdrOffset + offsetof(Elf64_Phdr_Safe, p_filesz),
                                          Size, Output.IsLittleEndian).getValueOr(0);
      Info.MemSize = readSafe<uint64_t>(Buffer, PhdrOffset + offsetof(Elf64_Phdr_Safe, p_memsz),
                                         Size, Output.IsLittleEndian).getValueOr(0);
      Info.Align = readSafe<uint64_t>(Buffer, PhdrOffset + offsetof(Elf64_Phdr_Safe, p_align),
                                       Size, Output.IsLittleEndian).getValueOr(0);
      
    } else {
      const Elf32_Phdr_Safe *Phdr = 
          reinterpret_cast<const Elf32_Phdr_Safe*>(Buffer + PhdrOffset);
      
      Info.Type = readSafe<uint32_t>(Buffer, PhdrOffset + offsetof(Elf32_Phdr_Safe, p_type),
                                      Size, Output.IsLittleEndian).getValueOr(0);
      Info.Offset = readSafe<uint32_t>(Buffer, PhdrOffset + offsetof(Elf32_Phdr_Safe, p_offset),
                                        Size, Output.IsLittleEndian).getValueOr(0);
      Info.VAddr = readSafe<uint32_t>(Buffer, PhdrOffset + offsetof(Elf32_Phdr_Safe, p_vaddr),
                                       Size, Output.IsLittleEndian).getValueOr(0);
      Info.PAddr = readSafe<uint32_t>(Buffer, PhdrOffset + offsetof(Elf32_Phdr_Safe, p_paddr),
                                       Size, Output.IsLittleEndian).getValueOr(0);
      Info.FileSize = readSafe<uint32_t>(Buffer, PhdrOffset + offsetof(Elf32_Phdr_Safe, p_filesz),
                                          Size, Output.IsLittleEndian).getValueOr(0);
      Info.MemSize = readSafe<uint32_t>(Buffer, PhdrOffset + offsetof(Elf32_Phdr_Safe, p_memsz),
                                         Size, Output.IsLittleEndian).getValueOr(0);
      Info.Flags = readSafe<uint32_t>(Buffer, PhdrOffset + offsetof(Elf32_Phdr_Safe, p_flags),
                                       Size, Output.IsLittleEndian).getValueOr(0);
      Info.Align = readSafe<uint32_t>(Buffer, PhdrOffset + offsetof(Elf32_Phdr_Safe, p_align),
                                       Size, Output.IsLittleEndian).getValueOr(0);
    }
    
    // Derivar flags
    Info.IsExecutable = (Info.Flags & PF_X) != 0;
    Info.IsWritable = (Info.Flags & PF_W) != 0;
    Info.IsReadable = (Info.Flags & PF_R) != 0;
    Info.IsLoadable = (Info.Type == PT_LOAD);
    Info.IsDynamic = (Info.Type == PT_DYNAMIC);
    Info.IsInterp = (Info.Type == PT_INTERP);
    
    // Validar
    Info.IsValid = true;
    
    // Se for PT_INTERP, extrair o caminho do interpretador
    if (Info.Type == PT_INTERP && Info.FileSize > 0 && Info.FileSize < 4096) {
      if (isSafeOffset(Info.Offset, Info.FileSize, Size)) {
        const char *InterpStr = reinterpret_cast<const char*>(Buffer + Info.Offset);
        Output.Interpreter = std::string(InterpStr, strnlen(InterpStr, Info.FileSize));
        if (VerboseMode) {
          Diagnostics.add(Severity::Debug, "Interpretador: " + Output.Interpreter);
        }
      }
    }
    
    Output.ProgramHeaders.push_back(std::move(Info));
    Output.Stats.ValidSegments++;
  }
  
  return Error::success();
}

//==============================================================================
// VALIDAÇÃO DE SECTION HEADERS
//==============================================================================

Error RobustELFExtractor::validateSectionHeaders(const uint8_t *Buffer, size_t Size,
                                                  RobustELFExtractedData &Output) {
  if (!Output.HasSectionHeaders) {
    return Error::success();
  }
  
  if (Output.SectionHeaderCount > SecLimits.MAX_SECTIONS) {
    return make_error<StringError>("Número excessivo de section headers: " +
                                   Twine(Output.SectionHeaderCount).str(),
                                   inconvertibleErrorCode());
  }
  
  size_t ShdrSize = Output.Is64Bit ? sizeof(Elf64_Shdr_Safe) : sizeof(Elf32_Shdr_Safe);
  size_t ShdrTableSize = Output.SectionHeaderCount * ShdrSize;
  
  if (!isSafeOffset(SectionHeaderOffset, ShdrTableSize, Size)) {
    return make_error<StringError>("Tabela de section headers além do buffer",
                                   inconvertibleErrorCode());
  }
  
  Output.Sections.clear();
  
  for (uint16_t i = 0; i < Output.SectionHeaderCount && i < SecLimits.MAX_SECTIONS; i++) {
    RobustELFSectionInfo Info;
    uint64_t ShdrOffset = SectionHeaderOffset + (i * ShdrSize);
    
    if (Output.Is64Bit) {
      const Elf64_Shdr_Safe *Shdr = 
          reinterpret_cast<const Elf64_Shdr_Safe*>(Buffer + ShdrOffset);
      
      Info.Name = readSafe<uint32_t>(Buffer, ShdrOffset + offsetof(Elf64_Shdr_Safe, sh_name),
                                      Size, Output.IsLittleEndian).getValueOr(0);
      Info.Type = readSafe<uint32_t>(Buffer, ShdrOffset + offsetof(Elf64_Shdr_Safe, sh_type),
                                      Size, Output.IsLittleEndian).getValueOr(0);
      Info.Flags = readSafe<uint64_t>(Buffer, ShdrOffset + offsetof(Elf64_Shdr_Safe, sh_flags),
                                       Size, Output.IsLittleEndian).getValueOr(0);
      Info.Address = readSafe<uint64_t>(Buffer, ShdrOffset + offsetof(Elf64_Shdr_Safe, sh_addr),
                                         Size, Output.IsLittleEndian).getValueOr(0);
      Info.Offset = readSafe<uint64_t>(Buffer, ShdrOffset + offsetof(Elf64_Shdr_Safe, sh_offset),
                                        Size, Output.IsLittleEndian).getValueOr(0);
      Info.Size = readSafe<uint64_t>(Buffer, ShdrOffset + offsetof(Elf64_Shdr_Safe, sh_size),
                                      Size, Output.IsLittleEndian).getValueOr(0);
      Info.Link = readSafe<uint32_t>(Buffer, ShdrOffset + offsetof(Elf64_Shdr_Safe, sh_link),
                                      Size, Output.IsLittleEndian).getValueOr(0);
      Info.Info = readSafe<uint32_t>(Buffer, ShdrOffset + offsetof(Elf64_Shdr_Safe, sh_info),
                                      Size, Output.IsLittleEndian).getValueOr(0);
      Info.AddrAlign = readSafe<uint64_t>(Buffer, ShdrOffset + offsetof(Elf64_Shdr_Safe, sh_addralign),
                                           Size, Output.IsLittleEndian).getValueOr(0);
      Info.EntSize = readSafe<uint64_t>(Buffer, ShdrOffset + offsetof(Elf64_Shdr_Safe, sh_entsize),
                                         Size, Output.IsLittleEndian).getValueOr(0);
      
    } else {
      const Elf32_Shdr_Safe *Shdr = 
          reinterpret_cast<const Elf32_Shdr_Safe*>(Buffer + ShdrOffset);
      
      Info.Name = readSafe<uint32_t>(Buffer, ShdrOffset + offsetof(Elf32_Shdr_Safe, sh_name),
                                      Size, Output.IsLittleEndian).getValueOr(0);
      Info.Type = readSafe<uint32_t>(Buffer, ShdrOffset + offsetof(Elf32_Shdr_Safe, sh_type),
                                      Size, Output.IsLittleEndian).getValueOr(0);
      Info.Flags = readSafe<uint32_t>(Buffer, ShdrOffset + offsetof(Elf32_Shdr_Safe, sh_flags),
                                       Size, Output.IsLittleEndian).getValueOr(0);
      Info.Address = readSafe<uint32_t>(Buffer, ShdrOffset + offsetof(Elf32_Shdr_Safe, sh_addr),
                                         Size, Output.IsLittleEndian).getValueOr(0);
      Info.Offset = readSafe<uint32_t>(Buffer, ShdrOffset + offsetof(Elf32_Shdr_Safe, sh_offset),
                                        Size, Output.IsLittleEndian).getValueOr(0);
      Info.Size = readSafe<uint32_t>(Buffer, ShdrOffset + offsetof(Elf32_Shdr_Safe, sh_size),
                                      Size, Output.IsLittleEndian).getValueOr(0);
      Info.Link = readSafe<uint32_t>(Buffer, ShdrOffset + offsetof(Elf32_Shdr_Safe, sh_link),
                                      Size, Output.IsLittleEndian).getValueOr(0);
      Info.Info = readSafe<uint32_t>(Buffer, ShdrOffset + offsetof(Elf32_Shdr_Safe, sh_info),
                                      Size, Output.IsLittleEndian).getValueOr(0);
      Info.AddrAlign = readSafe<uint32_t>(Buffer, ShdrOffset + offsetof(Elf32_Shdr_Safe, sh_addralign),
                                           Size, Output.IsLittleEndian).getValueOr(0);
      Info.EntSize = readSafe<uint32_t>(Buffer, ShdrOffset + offsetof(Elf32_Shdr_Safe, sh_entsize),
                                         Size, Output.IsLittleEndian).getValueOr(0);
    }
    
    // Derivar flags
    Info.IsAlloc = (Info.Flags & SHF_ALLOC) != 0;
    Info.IsExecutable = (Info.Flags & SHF_EXECINSTR) != 0;
    Info.IsWritable = (Info.Flags & SHF_WRITE) != 0;
    Info.IsReadable = !Info.IsWritable || (Info.Flags & SHF_ALLOC) != 0;
    Info.IsLoadable = (Info.Type == SHT_PROGBITS || Info.Type == SHT_NOBITS) && Info.IsAlloc;
    Info.IsDebug = (Info.Type == SHT_PROGBITS && 
                    (Info.Name == 0 || (Info.Name > 0 && Info.Name < 100)));
    
    // Validar
    if (Info.Type == SHT_NOBITS) {
      Info.IsValid = true;
      Info.Size = 0; // BSS não ocupa espaço no arquivo
    } else if (Info.Type == SHT_PROGBITS && Info.Size > 0) {
      if (!isSafeOffset(Info.Offset, Info.Size, Size)) {
        Info.IsTruncated = true;
        Info.ValidationError = "Dados truncados";
        Output.Stats.TruncatedSections++;
      } else {
        Info.IsValid = true;
        Output.Stats.ValidSections++;
        Output.Stats.TotalRawSize += Info.Size;
      }
    } else {
      Info.IsValid = true; // Seções especiais são válidas mesmo sem dados
    }
    
    Output.Sections.push_back(std::move(Info));
  }
  
  // Validar string table de seções
  if (Output.SectionHeaderStringIndex > 0 && 
      Output.SectionHeaderStringIndex < Output.Sections.size()) {
    const auto &StrTabSection = Output.Sections[Output.SectionHeaderStringIndex];
    if (StrTabSection.IsValid && StrTabSection.Type == SHT_STRTAB &&
        isSafeOffset(StrTabSection.Offset, StrTabSection.Size, Size)) {
      SectionStringTableOffset = StrTabSection.Offset;
      Output.SectionStringTableSize = StrTabSection.Size;
      
      // Atualizar nomes das seções
      for (auto &Section : Output.Sections) {
        if (Section.Name > 0 && Section.Name < StrTabSection.Size) {
          const char *NamePtr = reinterpret_cast<const char*>(Buffer + 
              StrTabSection.Offset + Section.Name);
          Section.Name = std::string(NamePtr, strnlen(NamePtr, 256));
        }
      }
    }
  }
  
  return Error::success();
}

//==============================================================================
// EXTRAÇÃO DE DADOS DOS SEGMENTOS (PT_LOAD)
//==============================================================================

Error RobustELFExtractor::extractFromProgramHeaders(const uint8_t *Buffer, size_t Size,
                                                     RobustELFExtractedData &Output) {
  Output.CodeBuffer.clear();
  Output.DataBuffer.clear();
  Output.RodataBuffer.clear();
  Output.BssSize = 0;
  
  for (const auto &Phdr : Output.ProgramHeaders) {
    if (!Phdr.IsLoadable || Phdr.Type != PT_LOAD) {
      continue;
    }
    
    if (Phdr.FileSize == 0 && Phdr.MemSize > 0) {
      // Segmento BSS
      Output.BssSize += Phdr.MemSize;
      continue;
    }
    
    if (!isSafeOffset(Phdr.Offset, Phdr.FileSize, Size)) {
      Diagnostics.add(Severity::Warning,
                      "Segmento truncado: offset=0x" + Twine::utohexstr(Phdr.Offset).str() +
                      ", size=" + Twine(Phdr.FileSize).str());
      continue;
    }
    
    const uint8_t *SegmentData = Buffer + Phdr.Offset;
    
    // Classificar baseado nas flags
    if (Phdr.IsExecutable) {
      size_t OldSize = Output.CodeBuffer.size();
      Output.CodeBuffer.resize(OldSize + Phdr.FileSize);
      memcpy(Output.CodeBuffer.data() + OldSize, SegmentData, Phdr.FileSize);
      
    } else if (Phdr.IsWritable) {
      size_t OldSize = Output.DataBuffer.size();
      Output.DataBuffer.resize(OldSize + Phdr.FileSize);
      memcpy(Output.DataBuffer.data() + OldSize, SegmentData, Phdr.FileSize);
      
    } else if (Phdr.IsReadable) {
      size_t OldSize = Output.RodataBuffer.size();
      Output.RodataBuffer.resize(OldSize + Phdr.FileSize);
      memcpy(Output.RodataBuffer.data() + OldSize, SegmentData, Phdr.FileSize);
    }
  }
  
  if (VerboseMode) {
    Diagnostics.add(Severity::Info,
                    "Extraído de segmentos: code=" + Twine(Output.CodeBuffer.size()).str() +
                    ", data=" + Twine(Output.DataBuffer.size()).str() +
                    ", rodata=" + Twine(Output.RodataBuffer.size()).str());
  }
  
  return Error::success();
}

//==============================================================================
// EXTRAÇÃO DE DADOS DAS SEÇÕES (HEURÍSTICA)
//==============================================================================

Error RobustELFExtractor::extractFromSectionsWithHeuristics(const uint8_t *Buffer, size_t Size,
                                                             RobustELFExtractedData &Output) {
  Output.CodeBuffer.clear();
  Output.DataBuffer.clear();
  Output.RodataBuffer.clear();
  Output.BssSize = 0;
  
  for (const auto &Section : Output.Sections) {
    if (!Section.IsValid || Section.Type == SHT_NULL) {
      continue;
    }
    
    if (Section.Type == SHT_NOBITS) {
      // Seção BSS
      if (Section.IsAlloc && Section.IsWritable) {
        Output.BssSize += Section.Size;
      }
      continue;
    }
    
    if (Section.Size == 0 || Section.Type != SHT_PROGBITS) {
      continue;
    }
    
    if (!isSafeOffset(Section.Offset, Section.Size, Size)) {
      Diagnostics.addSection(Severity::Warning,
                             "Dados da seção truncados",
                             Output.Sections.size(), Section.Name);
      continue;
    }
    
    const uint8_t *SectionData = Buffer + Section.Offset;
    
    // Classificar por nome e flags
    std::string NameLower = Section.Name;
    std::transform(NameLower.begin(), NameLower.end(), NameLower.begin(), ::tolower);
    
    // Seções de código
    if (Section.IsExecutable || 
        NameLower == ".text" || NameLower == ".init" || NameLower == ".fini" ||
        NameLower == ".plt" || NameLower == ".got" || NameLower == ".got.plt") {
      size_t OldSize = Output.CodeBuffer.size();
      Output.CodeBuffer.resize(OldSize + Section.Size);
      memcpy(Output.CodeBuffer.data() + OldSize, SectionData, Section.Size);
      
    // Seções de dados somente leitura
    } else if (!Section.IsWritable && Section.IsAlloc &&
               (NameLower == ".rodata" || NameLower.find(".rodata.") == 0 ||
                NameLower == ".rdata" || NameLower == ".const" ||
                NameLower == ".ctors" || NameLower == ".dtors")) {
      size_t OldSize = Output.RodataBuffer.size();
      Output.RodataBuffer.resize(OldSize + Section.Size);
      memcpy(Output.RodataBuffer.data() + OldSize, SectionData, Section.Size);
      
    // Seções de dados
    } else if (Section.IsWritable && Section.IsAlloc &&
               (NameLower == ".data" || NameLower.find(".data.") == 0 ||
                NameLower == ".bss" || NameLower == ".sbss" ||
                NameLower == ".tdata" || NameLower == ".tbss")) {
      if (Section.Type != SHT_NOBITS) {
        size_t OldSize = Output.DataBuffer.size();
        Output.DataBuffer.resize(OldSize + Section.Size);
        memcpy(Output.DataBuffer.data() + OldSize, SectionData, Section.Size);
      }
      
    // Seções de debug - ignorar para o código principal
    } else if (isDwarfSection(Section.Name) || isStabSection(Section.Name)) {
      Output.HasDebugInfo = true;
      Output.DebugData.insert(Output.DebugData.end(), 
                              SectionData, SectionData + Section.Size);
      if (NameLower == ".debug_info") Output.HasDwarfInfo = true;
      if (NameLower == ".stab") Output.HasStabInfo = true;
      
    // Seções especiais
    } else if (NameLower == ".interp") {
      const char *InterpStr = reinterpret_cast<const char*>(SectionData);
      Output.Interpreter = std::string(InterpStr, strnlen(InterpStr, Section.Size));
      
    } else if (NameLower == ".dynamic") {
      Output.DynamicData.assign(SectionData, SectionData + Section.Size);
      
    } else if (NameLower.find(".note.") == 0) {
      Output.NoteData.insert(Output.NoteData.end(), 
                             SectionData, SectionData + Section.Size);
    }
  }
  
  // Heurística: se não encontrou código, usar seção .text se existir
  if (Output.CodeBuffer.empty()) {
    for (const auto &Section : Output.Sections) {
      if (Section.IsValid && Section.Type == SHT_PROGBITS &&
          Section.IsAlloc && Section.Size > 0) {
        // Tudo que for alocado e não for dados pode ser código
        if (!Section.IsWritable && isSafeOffset(Section.Offset, Section.Size, Size)) {
          Output.CodeBuffer.assign(Buffer + Section.Offset, 
                                   Buffer + Section.Offset + Section.Size);
          Diagnostics.add(Severity::Warning,
                          "Usando seção " + Section.Name + " como código por heurística");
          break;
        }
      }
    }
  }
  
  return Error::success();
}

//==============================================================================
// EXTRAÇÃO DE SÍMBOLOS
//==============================================================================

Error RobustELFExtractor::extractSymbolsRobust(const uint8_t *Buffer, size_t Size,
                                                RobustELFExtractedData &Output) {
  Output.Symbols.clear();
  
  // Procurar pela tabela de símbolos
  uint64_t SymTabOffset = 0;
  uint64_t SymTabSize = 0;
  uint64_t SymTabEntrySize = 0;
  uint64_t SymStrTabOffset = 0;
  uint64_t SymStrTabSize = 0;
  uint32_t SymTabIndex = 0;
  uint32_t DynSymTabIndex = 0;
  
  // Encontrar .symtab e .strtab
  for (size_t i = 0; i < Output.Sections.size(); i++) {
    const auto &Section = Output.Sections[i];
    
    if (Section.Type == SHT_SYMTAB) {
      SymTabIndex = i;
      SymTabOffset = Section.Offset;
      SymTabSize = Section.Size;
      SymTabEntrySize = Section.EntSize;
      if (Section.Link > 0 && Section.Link < Output.Sections.size()) {
        const auto &StrTab = Output.Sections[Section.Link];
        if (StrTab.Type == SHT_STRTAB) {
          SymStrTabOffset = StrTab.Offset;
          SymStrTabSize = StrTab.Size;
        }
      }
      break;
    } else if (Section.Type == SHT_DYNSYM) {
      DynSymTabIndex = i;
      // Se não encontrar .symtab, usar .dynsym
      if (SymTabOffset == 0) {
        SymTabOffset = Section.Offset;
        SymTabSize = Section.Size;
        SymTabEntrySize = Section.EntSize;
        if (Section.Link > 0 && Section.Link < Output.Sections.size()) {
          const auto &StrTab = Output.Sections[Section.Link];
          if (StrTab.Type == SHT_STRTAB) {
            SymStrTabOffset = StrTab.Offset;
            SymStrTabSize = StrTab.Size;
          }
        }
      }
    }
  }
  
  if (SymTabOffset == 0 || SymTabSize == 0) {
    Output.IsStripped = true;
    if (VerboseMode) {
      Diagnostics.add(Severity::Debug, "ELF sem símbolos (stripped)");
    }
    return Error::success();
  }
  
  if (!isSafeOffset(SymTabOffset, SymTabSize, Size)) {
    return make_error<StringError>("Tabela de símbolos além do buffer",
                                   inconvertibleErrorCode());
  }
  
  if (SymTabEntrySize == 0) {
    SymTabEntrySize = Output.Is64Bit ? sizeof(Elf64_Sym_Safe) : sizeof(Elf32_Sym_Safe);
  }
  
  size_t NumSymbols = SymTabSize / SymTabEntrySize;
  if (NumSymbols > SecLimits.MAX_SYMBOLS) {
    NumSymbols = SecLimits.MAX_SYMBOLS;
    Diagnostics.add(Severity::Warning, "Limitando número de símbolos a " +
                    Twine(SecLimits.MAX_SYMBOLS).str());
  }
  
  for (size_t i = 0; i < NumSymbols; i++) {
    RobustELFSymbolInfo Info;
    uint64_t SymOffset = SymTabOffset + (i * SymTabEntrySize);
    
    if (Output.Is64Bit) {
      const Elf64_Sym_Safe *Sym = 
          reinterpret_cast<const Elf64_Sym_Safe*>(Buffer + SymOffset);
      
      Info.Name = readSafe<uint32_t>(Buffer, SymOffset + offsetof(Elf64_Sym_Safe, st_name),
                                      Size, Output.IsLittleEndian).getValueOr(0);
      Info.Value = readSafe<uint64_t>(Buffer, SymOffset + offsetof(Elf64_Sym_Safe, st_value),
                                       Size, Output.IsLittleEndian).getValueOr(0);
      Info.Size = readSafe<uint64_t>(Buffer, SymOffset + offsetof(Elf64_Sym_Safe, st_size),
                                      Size, Output.IsLittleEndian).getValueOr(0);
      
      uint8_t InfoByte = readSafe<uint8_t>(Buffer, SymOffset + offsetof(Elf64_Sym_Safe, st_info),
                                            Size, Output.IsLittleEndian).getValueOr(0);
      Info.Bind = ELF_ST_BIND(InfoByte);
      Info.Type = ELF_ST_TYPE(InfoByte);
      
      Info.Visibility = readSafe<uint8_t>(Buffer, SymOffset + offsetof(Elf64_Sym_Safe, st_other),
                                           Size, Output.IsLittleEndian).getValueOr(0);
      Info.SectionIndex = readSafe<uint16_t>(Buffer, SymOffset + offsetof(Elf64_Sym_Safe, st_shndx),
                                              Size, Output.IsLittleEndian).getValueOr(0);
      
    } else {
      const Elf32_Sym_Safe *Sym = 
          reinterpret_cast<const Elf32_Sym_Safe*>(Buffer + SymOffset);
      
      Info.Name = readSafe<uint32_t>(Buffer, SymOffset + offsetof(Elf32_Sym_Safe, st_name),
                                      Size, Output.IsLittleEndian).getValueOr(0);
      Info.Value = readSafe<uint32_t>(Buffer, SymOffset + offsetof(Elf32_Sym_Safe, st_value),
                                       Size, Output.IsLittleEndian).getValueOr(0);
      Info.Size = readSafe<uint32_t>(Buffer, SymOffset + offsetof(Elf32_Sym_Safe, st_size),
                                      Size, Output.IsLittleEndian).getValueOr(0);
      
      uint8_t InfoByte = readSafe<uint8_t>(Buffer, SymOffset + offsetof(Elf32_Sym_Safe, st_info),
                                            Size, Output.IsLittleEndian).getValueOr(0);
      Info.Bind = ELF_ST_BIND(InfoByte);
      Info.Type = ELF_ST_TYPE(InfoByte);
      
      Info.Visibility = readSafe<uint8_t>(Buffer, SymOffset + offsetof(Elf32_Sym_Safe, st_other),
                                           Size, Output.IsLittleEndian).getValueOr(0);
      Info.SectionIndex = readSafe<uint16_t>(Buffer, SymOffset + offsetof(Elf32_Sym_Safe, st_shndx),
                                              Size, Output.IsLittleEndian).getValueOr(0);
    }
    
    // Derivar flags
    Info.IsGlobal = (Info.Bind == STB_GLOBAL || Info.Bind == STB_WEAK);
    Info.IsWeak = (Info.Bind == STB_WEAK);
    Info.IsFunction = (Info.Type == STT_FUNC);
    Info.IsObject = (Info.Type == STT_OBJECT);
    
    // Obter nome do símbolo da string table
    if (Info.Name > 0 && SymStrTabOffset > 0 && Info.Name < SymStrTabSize) {
      if (isSafeOffset(SymStrTabOffset + Info.Name, 1, Size)) {
        const char *NamePtr = reinterpret_cast<const char*>(Buffer + 
            SymStrTabOffset + Info.Name);
        size_t MaxLen = std::min<size_t>(SymStrTabSize - Info.Name, 256);
        Info.Name = std::string(NamePtr, strnlen(NamePtr, MaxLen));
      }
    }
    
    // Validar
    if (Info.Type != STT_NOTYPE || Info.Size > 0) {
      Info.IsValid = true;
      Output.Stats.ValidSymbols++;
      Output.Symbols.push_back(std::move(Info));
    }
  }
  
  if (VerboseMode) {
    Diagnostics.add(Severity::Debug,
                    "Símbolos extraídos: " + Twine(Output.Stats.ValidSymbols).str());
  }
  
  return Error::success();
}

//==============================================================================
// EXTRAÇÃO DE RELOCAÇÕES
//==============================================================================

Error RobustELFExtractor::extractRelocationsRobust(const uint8_t *Buffer, size_t Size,
                                                    RobustELFExtractedData &Output) {
  Output.Relocations.clear();
  
  for (const auto &Section : Output.Sections) {
    if (Section.Type != SHT_REL && Section.Type != SHT_RELA) {
      continue;
    }
    
    if (!isSafeOffset(Section.Offset, Section.Size, Size)) {
      continue;
    }
    
    size_t RelEntrySize = Section.EntSize;
    if (RelEntrySize == 0) {
      RelEntrySize = Output.Is64Bit ? 
          (Section.Type == SHT_RELA ? sizeof(Elf64_Rela) : sizeof(Elf64_Rel)) :
          (Section.Type == SHT_RELA ? sizeof(Elf32_Rela) : sizeof(Elf32_Rel));
    }
    
    size_t NumRels = Section.Size / RelEntrySize;
    if (NumRels > 1000000) { // Limite de segurança
      Diagnostics.add(Severity::Warning, "Muitas relocações em " + Section.Name);
      continue;
    }
    
    // Encontrar tabela de símbolos associada
    uint64_t SymTabOffset = 0;
    if (Section.Link > 0 && Section.Link < Output.Sections.size()) {
      const auto &SymTab = Output.Sections[Section.Link];
      if (SymTab.Type == SHT_SYMTAB || SymTab.Type == SHT_DYNSYM) {
        SymTabOffset = SymTab.Offset;
      }
    }
    
    for (size_t i = 0; i < NumRels; i++) {
      RobustELFRelocationInfo Info;
      uint64_t RelOffset = Section.Offset + (i * RelEntrySize);
      
      if (Section.Type == SHT_RELA) {
        if (Output.Is64Bit) {
          const Elf64_Rela *Rela = reinterpret_cast<const Elf64_Rela*>(Buffer + RelOffset);
          Info.Offset = readSafe<uint64_t>(Buffer, RelOffset + offsetof(Elf64_Rela, r_offset),
                                            Size, Output.IsLittleEndian).getValueOr(0);
          Info.Info = readSafe<uint64_t>(Buffer, RelOffset + offsetof(Elf64_Rela, r_info),
                                          Size, Output.IsLittleEndian).getValueOr(0);
          Info.Addend = readSafe<int64_t>(Buffer, RelOffset + offsetof(Elf64_Rela, r_addend),
                                           Size, Output.IsLittleEndian).getValueOr(0);
        } else {
          const Elf32_Rela *Rela = reinterpret_cast<const Elf32_Rela*>(Buffer + RelOffset);
          Info.Offset = readSafe<uint32_t>(Buffer, RelOffset + offsetof(Elf32_Rela, r_offset),
                                            Size, Output.IsLittleEndian).getValueOr(0);
          Info.Info = readSafe<uint32_t>(Buffer, RelOffset + offsetof(Elf32_Rela, r_info),
                                          Size, Output.IsLittleEndian).getValueOr(0);
          Info.Addend = readSafe<int32_t>(Buffer, RelOffset + offsetof(Elf32_Rela, r_addend),
                                           Size, Output.IsLittleEndian).getValueOr(0);
        }
      } else {
        // SHT_REL
        if (Output.Is64Bit) {
          const Elf64_Rel *Rel = reinterpret_cast<const Elf64_Rel*>(Buffer + RelOffset);
          Info.Offset = readSafe<uint64_t>(Buffer, RelOffset + offsetof(Elf64_Rel, r_offset),
                                            Size, Output.IsLittleEndian).getValueOr(0);
          Info.Info = readSafe<uint64_t>(Buffer, RelOffset + offsetof(Elf64_Rel, r_info),
                                          Size, Output.IsLittleEndian).getValueOr(0);
          Info.Addend = 0;
        } else {
          const Elf32_Rel *Rel = reinterpret_cast<const Elf32_Rel*>(Buffer + RelOffset);
          Info.Offset = readSafe<uint32_t>(Buffer, RelOffset + offsetof(Elf32_Rel, r_offset),
                                            Size, Output.IsLittleEndian).getValueOr(0);
          Info.Info = readSafe<uint32_t>(Buffer, RelOffset + offsetof(Elf32_Rel, r_info),
                                          Size, Output.IsLittleEndian).getValueOr(0);
          Info.Addend = 0;
        }
      }
      
      Info.Type = ELF_R_TYPE(Info.Info, Output.Is64Bit);
      Info.SymbolIndex = ELF_R_SYM(Info.Info, Output.Is64Bit);
      
      // Tentar obter nome do símbolo
      if (SymTabOffset > 0 && Info.SymbolIndex > 0) {
        // Buscar símbolo na tabela
        size_t SymEntrySize = Output.Is64Bit ? sizeof(Elf64_Sym_Safe) : sizeof(Elf32_Sym_Safe);
        uint64_t SymOffset = SymTabOffset + (Info.SymbolIndex * SymEntrySize);
        
        if (isSafeOffset(SymOffset, SymEntrySize, Size)) {
          // Extrair nome do símbolo (implementação simplificada)
          Info.SymbolName = "symbol_" + Twine(Info.SymbolIndex).str();
        }
      }
      
      Info.IsValid = true;
      Output.Relocations.push_back(std::move(Info));
    }
  }
  
  return Error::success();
}

//==============================================================================
// EXTRAÇÃO DE NOTAS ELF
//==============================================================================

Error RobustELFExtractor::extractNotesRobust(const uint8_t *Buffer, size_t Size,
                                              RobustELFExtractedData &Output) {
  for (const auto &Section : Output.Sections) {
    if (Section.Type != SHT_NOTE) {
      continue;
    }
    
    if (!isSafeOffset(Section.Offset, Section.Size, Size)) {
      continue;
    }
    
    Output.NoteData.insert(Output.NoteData.end(),
                           Buffer + Section.Offset,
                           Buffer + Section.Offset + Section.Size);
  }
  
  return Error::success();
}

//==============================================================================
// EXTRAÇÃO DE DEBUG INFO
//==============================================================================

Error RobustELFExtractor::extractDebugInfoRobust(const uint8_t *Buffer, size_t Size,
                                                  RobustELFExtractedData &Output) {
  Output.HasDebugInfo = false;
  Output.DebugData.clear();
  
  for (const auto &Section : Output.Sections) {
    if (!Section.IsValid || Section.Type != SHT_PROGBITS) {
      continue;
    }
    
    std::string NameLower = Section.Name;
    std::transform(NameLower.begin(), NameLower.end(), NameLower.begin(), ::tolower);
    
    if (isDwarfSection(NameLower) || isStabSection(NameLower)) {
      if (isSafeOffset(Section.Offset, Section.Size, Size)) {
        Output.HasDebugInfo = true;
        if (NameLower.find(".debug_") == 0) Output.HasDwarfInfo = true;
        if (NameLower.find(".stab") == 0) Output.HasStabInfo = true;
        
        Output.DebugData.insert(Output.DebugData.end(),
                                Buffer + Section.Offset,
                                Buffer + Section.Offset + Section.Size);
      }
    }
  }
  
  return Error::success();
}

bool RobustELFExtractor::isDwarfSection(const std::string &Name) {
  std::string NameLower = Name;
  std::transform(NameLower.begin(), NameLower.end(), NameLower.begin(), ::tolower);
  return (NameLower.find(".debug_") == 0 || 
          NameLower == ".zdebug_info" ||
          NameLower == ".zdebug_abbrev" ||
          NameLower == ".zdebug_line" ||
          NameLower == ".zdebug_frame" ||
          NameLower == ".zdebug_str");
}

bool RobustELFExtractor::isStabSection(const std::string &Name) {
  std::string NameLower = Name;
  std::transform(NameLower.begin(), NameLower.end(), NameLower.begin(), ::tolower);
  return (NameLower == ".stab" || NameLower == ".stabstr");
}

